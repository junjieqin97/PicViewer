QMainWindow {
    background: #1f2226;
    color: #d7dbe0;
}

QMenuBar {
    background: #1f2226;
    color: #f0f3f6;
}

QMenuBar::item {
    background: transparent;
    color: #f0f3f6;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background: #353b43;
    color: #f0f3f6;
}

QMenuBar::item:pressed {
    background: #3f4a56;
    color: #ffffff;
}

QWidget#central {
    background: #1f2226;
    color: #d7dbe0;
}

QSplitter::handle {
    background: #30343a;
}

QSplitter::handle:hover {
    background: #4a515a;
}

QTabWidget#tabsImages::pane,
QTabWidget#tabsInfo::pane,
QTabWidget#tabsMetadata::pane {
    border: 1px solid #3b4149;
    background: #24282d;
}

QWidget#tabAnalysis,
QWidget#tabMetadata {
    background: #24282d;
}

QTabWidget#tabsImages::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background: #2b3036;
    color: #c7ccd2;
    border: 1px solid #3b4149;
    border-bottom-color: #24282d;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    min-height: 0px;
    padding: 2px 12px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background: #353b43;
    color: #eef1f4;
}

QTabBar::tab:selected {
    background: #3a414a;
    color: #ffffff;
    border-bottom-color: #3a414a;
}

QTabWidget#tabsImages QTabBar::tab {
    background: #272c33;
    color: #cbd2da;
    border: 1px solid #454d57;
    border-top: 2px solid transparent;
    border-bottom-color: #24282d;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-height: 0px;
    padding: 2px 10px 2px 12px;
    margin-right: 2px;
}

QTabWidget#tabsImages QTabBar::tab:hover {
    background: #34404b;
    color: #f3f6f8;
    border-color: #5d6976;
    border-top-color: #6f8fb8;
}

QTabWidget#tabsImages QTabBar::tab:selected {
    background: #3f4a56;
    color: #ffffff;
    border-color: #718297;
    border-top-color: #9fc4f0;
    border-bottom-color: #3f4a56;
}

QTabWidget#tabsImages QTabBar::tab:selected:hover {
    background: #45515f;
    border-color: #8294aa;
    border-top-color: #b4d2f2;
}

QWidget#floatingTabWindow {
    background: #1f2226;
    color: #d7dbe0;
}

QWidget#floatingTabContent {
    background: #24282d;
    border: 1px solid #3b4149;
    border-top: none;
}

QTabBar#floatingTabBar::tab {
    background: #272c33;
    color: #cbd2da;
    border: 1px solid #454d57;
    border-top: 2px solid #6f8fb8;
    border-bottom-color: #3f4a56;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-height: 0px;
    padding: 2px 12px;
    margin-right: 2px;
}

QTabBar#floatingTabBar::tab:selected {
    background: #3f4a56;
    color: #ffffff;
    border-color: #718297;
    border-top-color: #9fc4f0;
    border-bottom-color: #3f4a56;
}

QWidget#tabImagePlaceholder,
QStackedWidget#stackImageContent,
QWidget#widgetImageLoadState {
    background: #191b1f;
    color: #d7dbe0;
}

QWidget#pageImagePreview {
    background: #0f1114;
    color: #d7dbe0;
}

QWidget#emptyStateContent,
QWidget#imageLoadStateContent {
    background: transparent;
}

QLabel#labelEmptyTitle,
QLabel#labelImageLoadStateTitle {
    color: #f0f3f6;
}

QLabel#labelEmptyDescription,
QLabel#labelImageLoadStateDetail {
    color: #b9c0c8;
}

QLabel#labelEmptyDropHint {
    color: #d6dde6;
}

QLabel#labelEmptyFormats,
QLabel#labelEmptyOpenFileShortcut,
QLabel#labelEmptyOpenFolderShortcut,
QLabel#labelImageLoadStateFileName {
    color: #8f98a3;
}

QLabel#labelImageLoadStateReason {
    color: #e0896c;
}

QPushButton#buttonEmptyOpenFile,
QPushButton#buttonEmptyOpenFolder,
QPushButton#buttonImageLoadRetry {
    background: #3b4652;
    color: #f3f5f7;
    border: 1px solid #596573;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton#buttonEmptyOpenFile:hover,
QPushButton#buttonEmptyOpenFolder:hover,
QPushButton#buttonImageLoadRetry:hover {
    background: #465363;
}

QScrollArea#scrollImage {
    background: #0f1114;
    border: 1px solid #2e343b;
}

QWidget#viewportImageCanvas {
    background: #0f1114;
}

QLabel#lblImage {
    background: transparent;
    color: #cfd5dc;
}

QScrollArea#scrollImage QScrollBar:horizontal {
    background: #111419;
    border: none;
    height: 10px;
    margin: 0;
}

QScrollArea#scrollImage QScrollBar:vertical {
    background: #111419;
    border: none;
    width: 10px;
    margin: 0;
}

QScrollArea#scrollImage QScrollBar::handle:horizontal,
QScrollArea#scrollImage QScrollBar::handle:vertical {
    background: #3c4652;
    border-radius: 5px;
    min-width: 32px;
    min-height: 32px;
}

QScrollArea#scrollImage QScrollBar::handle:horizontal:hover,
QScrollArea#scrollImage QScrollBar::handle:vertical:hover {
    background: #596777;
}

QScrollArea#scrollImage QScrollBar::add-line,
QScrollArea#scrollImage QScrollBar::sub-line,
QScrollArea#scrollImage QScrollBar::add-page,
QScrollArea#scrollImage QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QWidget#scrollInfo {
    background: #252a30;
    border-left: 1px solid #343a42;
}

QFrame#widgetAnalysisToolbar {
    background: #20242a;
    border: 1px solid #343b44;
    border-radius: 3px;
}

QFrame#widgetAnalysisToolbar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 1px;
}

QFrame#widgetAnalysisToolbar QToolButton:hover {
    background: #2b333c;
    border-color: #4e5965;
}

QFrame#widgetAnalysisToolbar QToolButton:checked {
    background: #33465b;
    border-color: #8eb4df;
}

QFrame#separatorAnalysisToolbar {
    color: #3c434d;
    background: #3c434d;
    max-width: 1px;
    min-width: 1px;
    margin-left: 4px;
    margin-right: 4px;
}

QWidget#widgetAnalysisModeSummary {
    background: #20242a;
    border: 1px solid #384049;
    border-radius: 4px;
}

QLabel#labelAnalysisModeTitle,
QLabel#labelAnalysisChannelTitle,
QLabel#labelPseudoColorTitle {
    color: #9aa4af;
}

QLabel#labelAnalysisModeValue,
QLabel#labelAnalysisChannelValue,
QLabel#labelPseudoColorValue {
    color: #edf1f5;
}

QFrame#frameHistogramAnalysis,
QFrame#frameWaveformAnalysis {
    background: #171a1e;
    border: 1px solid #424a54;
    border-radius: 4px;
}

QLabel#widgetHistogram,
QLabel#widgetWaveform {
    background: #111316;
    color: #cdd3da;
}

QTextBrowser#textThirdPartyLicenses,
QPlainTextEdit#textLicenseDocument {
    background: #1b1f24;
    color: #d8dde3;
    border: 1px solid #343b44;
    selection-background-color: #3d4d60;
    selection-color: #ffffff;
}

QFrame#frameFilmstrip {
    background: #20242a;
    border: 1px solid #343b44;
}

QListWidget#listFilmstrip {
    background: #181b20;
    color: #cbd2da;
    border: 1px solid #303741;
    outline: none;
}

QListWidget#listFilmstrip::item {
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px;
}

QListWidget#listFilmstrip::item:hover {
    background: #29313a;
    border-color: #546170;
}

QListWidget#listFilmstrip::item:selected {
    background: #33465b;
    border-color: #9bbce3;
    color: #ffffff;
}

QTableWidget {
    background: #1b1f24;
    alternate-background-color: #22272e;
    color: #d8dde3;
    gridline-color: #333a43;
    border: 1px solid #343b44;
    selection-background-color: #3d4d60;
    selection-color: #ffffff;
}

QHeaderView::section {
    background: #293039;
    color: #dce1e6;
    border: 0;
    border-right: 1px solid #3a424c;
    border-bottom: 1px solid #3a424c;
    padding: 5px 8px;
}

QScrollBar:horizontal,
QScrollBar:vertical {
    background: #1a1e23;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
    background: #4a535f;
    border-radius: 4px;
    min-width: 24px;
    min-height: 24px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
    background: #5a6674;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QProgressBar#progressImageLoadState {
    background: #1b1f24;
    border: 1px solid #3b434d;
    border-radius: 4px;
}

QProgressBar#progressImageLoadState::chunk {
    background: #6f8fb8;
    border-radius: 3px;
}

QStatusBar {
    background: #20242a;
    color: #c7ced7;
    border-top: 1px solid #343b44;
}

QLabel#labelFilmstripSummary {
    color: #edf1f5;
    background: #2b3036;
    border: 1px solid #46505b;
    border-radius: 4px;
    padding: 2px 8px;
}
